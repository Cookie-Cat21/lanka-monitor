# Supabase — project URL and keys (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service-role key — SERVER SIDE ONLY, used by the Python ingest workers to write.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret protecting the ingest endpoint. Vercel Cron sends it automatically
# as "Authorization: Bearer $CRON_SECRET" when this env var is set on the project.
CRON_SECRET=generate-a-long-random-string

# OpenAQ — free API key at https://explore.openaq.org/register
OPENAQ_API_KEY=your-openaq-api-key

# Optional: Claude for trilingual daily brief (desk-v1 used when unset)
ANTHROPIC_API_KEY=

# Optional: CricAPI / CricketData key for live scores
CRICKET_API_KEY=
# or
CRICAPI_KEY=

# Optional: Telegram daily brief + threshold alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_URL=

# Contact URL advertised in the scraper User-Agent (be an honest bot).
BOT_CONTACT_URL=https://github.com/Cookie-Cat21/lanka-monitor
